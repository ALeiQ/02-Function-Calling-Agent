# LLM (local via Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5

# Agent loop
MAX_TURNS=8
TEMPERATURE=0.0

# Tools
DB_PATH=data/app.db

# 和风天气 QWeather（可选）：https://console.qweather.com 免费订阅后填入
# 未配置时自动退化为 Open-Meteo（免 key）
QWEATHER_API_KEY=

# API server
API_HOST=0.0.0.0
API_PORT=8001