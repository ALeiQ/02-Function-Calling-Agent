# LLM (local via Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
# qwen3 思考模式：true=开启(更严谨但每轮多花 8-9s)，false=关闭(默认,最快)
OLLAMA_THINK=false
# 模型驻留显存时长，避免空闲 5 分钟后被 Ollama 卸载(下次请求冷加载 10s+)；-1=常驻
OLLAMA_KEEP_ALIVE=30m

# Agent loop
MAX_TURNS=8
TEMPERATURE=0.0

# Tools
DB_PATH=data/app.db

# 和风天气 QWeather（可选）：https://console.qweather.com 注册后填入
# 每月前 5 万次免费（¥0）。未配置时自动退化为 Open-Meteo（免 key）
QWEATHER_API_KEY=
# 和风专属 API Host（控制台-设置中查看，形如 abcxyz.xx.qweatherapi.com）
# 填空则使用公共地址；2026 年起公共地址将逐步停服，建议配置
QWEATHER_BASE_URL=

# API server
API_HOST=0.0.0.0
API_PORT=8001