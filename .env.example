# LLM (local via Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5

# Agent loop
MAX_TURNS=8
TEMPERATURE=0.0

# Tools
DB_PATH=data/app.db

# 和风天气 QWeather（可选）：https://console.qweather.com 注册后填入
# 每月前 5 万次免费（¥0）。未配置时自动退化为 Open-Meteo（免 key）
QWEATHER_API_KEY=
# 和风专属 API Host（控制台-设置中查看，形如 abcxyz.xx.qweatherapi.com）
# 填空则使用公共地址；2026 年起公共地址将逐步停服，建议配置
QWEATHER_BASE_URL=

# API server
API_HOST=0.0.0.0
API_PORT=8001